{
  "manifest_version": 3,
  "name": "Codex Pro Inbox (local pilot)",
  "version": "0.3.1",
  "description": "Codex project-specific Pro results: automatic local routing, text and attachments, without model polling.",
  "permissions": [
    "storage",
    "downloads",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/c/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}